ROOMORA_DOMAIN=api.roomora.example
ROOMORA_WEB_ORIGIN=https://roomora.example

ROOMORA_API_IMAGE=ghcr.io/taopato/roomora-backend
ROOMORA_IMAGE_TAG=latest
ROOMORA_OCR_IMAGE=ghcr.io/taopato/roomora-ocr
ROOMORA_OCR_IMAGE_TAG=latest

ROOMORA_DB_NAME=RoomoraDb
MSSQL_PID=Express
MSSQL_SA_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD
ROOMORA_BACKUP_PATH=/opt/roomora/backups

TOKEN_SECURITY_KEY=CHANGE_ME_USE_AT_LEAST_64_RANDOM_CHARACTERS
TOKEN_ISSUER=https://api.roomora.example
TOKEN_AUDIENCE=https://api.roomora.example
TOKEN_EXPIRATION_MINUTES=60

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_SENDER_EMAIL=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
GOOGLE_CLIENT_ID=CHANGE_ME
APPLE_BUNDLE_ID=com.taopato.roomora
