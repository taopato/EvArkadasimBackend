# BEGIN ROOMORA ROUTES
api.roomora.com {
	encode zstd gzip
	reverse_proxy roomora-gateway:80
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

testapi.roomora.com {
	encode zstd gzip
	reverse_proxy roomora-gateway:80
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
# END ROOMORA ROUTES
