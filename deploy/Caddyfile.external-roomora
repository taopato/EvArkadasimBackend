# Add these handlers inside the control.builtwhys.space site block, before its
# generic control-center fallback handler.
handle_path /roomora-api/* {
	reverse_proxy roomora-gateway:80 {
		header_up Host api.roomora.builtwhys.space
	}
}

handle_path /roomora-testapi/* {
	reverse_proxy roomora-gateway:80 {
		header_up Host testapi.roomora.builtwhys.space
	}
}
